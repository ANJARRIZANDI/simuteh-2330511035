        "# Kode 2.2 Ambang Canny otomatis berbasis median\n",
        "def canny_otomatis(g, s=0.33):\n",
        "    \"\"\"Ambang dari median intensitas: bawah = (1-s) x median, atas = (1+s) x\n",
        "median.\"\"\"\n",
        "    v = np.median(g)\n",
        "    return cv2.Canny(g, int(max(0, (1 - s) * v)), int(min(255, (1 + s) * v)))\n",
        "\n",
        "baris = []\n",
        "for _, d in label[label.kelas != \"sehat\"].iterrows():\n",
        "    img, md, mb = muat(d.nama_file)\n",
        "    ac = cv2.bitwise_or(tepi_acuan(md), tepi_acuan(mb))\n",
        "    pra_ = praproses(img, PARAM)\n",
        "    for kanal, g in [(\"Gray\", cv2.cvtColor(pra_, cv2.COLOR_BGR2GRAY)), (\"R\",\n",
        "pra_[:, :, 2])]:\n",
        "        baris.append([d.kondisi_cahaya, kanal, \"otomatis\",\n",
