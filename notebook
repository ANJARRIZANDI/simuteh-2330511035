        "import numpy as np\n",
        "import cv2\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Definisikan Fungsi canny_persentil\n",
        "def canny_persentil(g, q, rasio=0.4, sigma=2.0):\n",
        "    # (1) Menghaluskan citra dengan Gaussian\n",
        "    if sigma > 0:\n",
        "        g_blur = cv2.GaussianBlur(g, (0, 0), sigma)\n",
        "    else:\n",
        "        g_blur = g\n",
        "\n",
        "    # Pastikan tipe data float32 untuk perhitungan Sobel\n",
        "    g_blur = g_blur.astype(np.float32)\n",
        "\n",
        "    # (2) Menghitung magnitudo Sobel\n",
        "    gx = cv2.Sobel(g_blur, cv2.CV_32F, 1, 0, ksize=3)\n",
        "    gy = cv2.Sobel(g_blur, cv2.CV_32F, 0, 1, ksize=3)\n",
        "    mag = np.hypot(gx, gy)\n",
        "\n",
        "    # (3) Menentukan ambang batas\n",
        "    if mag.max() > 0:\n",
        "        hi = np.percentile(mag, q)      # Ambang atas (persentil ke-q)\n",
        "        lo = rasio * hi                 # Ambang bawah (rasio x ambang atas)\n",
        "    else:\n",
        "        hi, lo = 0, 0\n",
        "\n",
        "    # (4) Memanggil cv2.Canny\n",
        "    # cv2.Canny membutuhkan input uint8\n",
        "    g_uint8 = np.uint8(np.clip(g_blur, 0, 255))\n",
        "    return cv2.Canny(g_uint8, lo, hi)\n",
        "\n",
