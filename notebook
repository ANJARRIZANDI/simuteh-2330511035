        "# Kode 1.3 Fungsi Sobel, Prewitt, LoG, dan Canny serta perbandingannya\n",
        "def tepi_sobel(g, T=100):\n",
        "    g = g.astype(np.float32)\n",
        "    m = np.hypot(cv2.Sobel(g, cv2.CV_32F, 1, 0), cv2.Sobel(g, cv2.CV_32F, 0, 1))\n",
        "    return ((m > T) * 255).astype(np.uint8)\n",
        "\n",
        "def tepi_prewitt(g, T=75):\n",
        "    kx = np.array([[-1, 0, 1], [-1, 0, 1], [-1, 0, 1]], np.float32)\n",
        "    g = g.astype(np.float32)\n",
        "    m = np.hypot(cv2.filter2D(g, -1, kx), cv2.filter2D(g, -1, kx.T))\n",
        "    return ((m > T) * 255).astype(np.uint8)\n",
        "\n",
        "def tepi_log(g, sigma=3.0, frac=0.2):\n",
        "    \"\"\"Laplacian of Gaussian: tepi = perlintasan nol yang cukup kuat.\"\"\"\n",
        "    L = cv2.Laplacian(cv2.GaussianBlur(g.astype(np.float32), (0, 0), sigma),\n",
        "cv2.CV_32F)\n",
        "    mn, mx = cv2.erode(L, np.ones((3, 3))), cv2.dilate(L, np.ones((3, 3)))\n",
        "    return (((mn < 0) & (mx > 0) & (mx - mn > frac * np.abs(L).max())) *\n",
        "255).astype(np.uint8)\n",
        "\n",
        "def tepi_canny(g, lo=30, hi=90, sigma=2.0):\n",
        "    if sigma > 0:\n",
        "        g = cv2.GaussianBlur(g, (0, 0), sigma)\n",
        "    return cv2.Canny(g, lo, hi)\n",
        "\n",
        "metode = {\"Sobel\": tepi_sobel, \"Prewitt\": tepi_prewitt, \"LoG\": tepi_log,\n",
        "\"Canny\": tepi_canny}\n",
        "g = pra[:, :, 2]\n",
        "hasil = {nm: f(g) for nm, f in metode.items()}\n",
        "tampil(list(hasil.values()), [f\"{nm}  P/R/F1={skor_tepi(e, acuan)}\" for nm, e\n",
        "in hasil.items()],\n",
        "       ukuran=(17, 3.6))"
